{
  "name": "makoedit",
  "version": "1.0.0",
  "description": "Client-safe content editing for Mako Logics fleet sites. Clients edit text, images and links; Mako owns structure and SEO.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./stega": {
      "types": "./dist/stega.d.ts",
      "import": "./dist/stega.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "test": "npm run build && node ./smoke.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MakoBytes-com/makoedit.git"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
